{
  "compilerOptions": {
    "moduleResolution": "Node",
    "target": "ESNext",
    "module": "ESNext",
    "paths": {
      "$lib": ["src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$wails/*": ["./bindings/*"]
    },

    "isolatedModules": true,
    "resolveJsonModule": true,

    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",

    "checkJs": true
  },

  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.svelte"
, "src/lib/functions/subscribe.ts"  ]
}
